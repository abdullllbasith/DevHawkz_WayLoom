{
  "name": "@wayloom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WayLoom Node.js API foundation.",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=../../.env dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.json --pretty false",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:status": "node scripts/prisma-database.mjs status",
    "prisma:check": "node scripts/prisma-database.mjs check",
    "prisma:reset-test": "node scripts/prisma-database.mjs reset-test test",
    "test": "node --test dist/import/competition-import.test.js dist/import/outlets.test.js dist/import/vehicles.test.js dist/import/calendar.test.js dist/import/district-travel.test.js dist/import/service-allowance.test.js dist/import/traffic-speed.test.js dist/import/road-conditions.test.js dist/import/lineage.test.js dist/seed/scenario.test.js dist/security/password.test.js dist/security/session.test.js dist/security/auth.test.js dist/security/rbac.test.js dist/security/object-authorization.test.js dist/security/api-boundary.test.js dist/security/csrf.test.js dist/security/login-rate-limit.test.js",
    "import:competition": "node dist/import/cli.js",
    "import:outlets": "node dist/import/outlets-cli.js",
    "import:vehicles": "node dist/import/vehicles-cli.js",
    "import:calendar": "node dist/import/calendar-cli.js",
    "import:district-travel": "node dist/import/district-travel-cli.js",
    "import:service-allowance": "node dist/import/service-allowance-cli.js",
    "import:traffic-speed": "node dist/import/traffic-speed-cli.js",
    "import:road-conditions": "node dist/import/road-conditions-cli.js",
    "seed:scenario": "node dist/seed/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "prisma": "7.10.0"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  }
}
