generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OperationalRole {
  DISPATCHER
  LOADER
  DRIVER
  STORE_MANAGER

  @@map("operational_role")
}

/// Identity record only. Login, sessions, and password hashing are not implemented here.
model User {
  id              String          @id @default(uuid()) @db.Uuid
  loginIdentifier String          @unique @map("login_identifier")
  displayName     String          @map("display_name")
  role            OperationalRole
  active          Boolean
  passwordHash    String          @map("password_hash")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  drivenVehicles   Vehicle[]
  createdOrders    Order[]
  loadingRecords    LoadingRecord[]   @relation("LoadingLoader")
  deliveryRecords   DeliveryRecord[]  @relation("DeliveryDriver")
  capturedProofs    ProofOfDelivery[] @relation("ProofCapturer")
  reportedExceptions Exception[]      @relation("ExceptionReporter")
  receipts          Receipt[]         @relation("ReceiptStoreManager")
  auditEvents       AuditEvent[]

  @@map("users")
}

enum Depot {
  Peliyagoda
  Kandy

  @@map("depot")
}

enum OutletBrand {
  Fresh
  Style
  Tech

  @@map("outlet_brand")
}

enum DockType {
  rear_dock
  street
  mall_bay

  @@map("dock_type")
}

enum ParkingConstraint {
  normal
  van_only
  mall_dock

  @@map("parking_constraint")
}

enum VehicleType {
  truck
  van

  @@map("vehicle_type")
}

enum VehicleTemperatureCapability {
  reefer
  ambient

  @@map("vehicle_temperature_capability")
}

/// Outlet master data. The UUID is the internal identity. outlet_id is the source identifier.
model Outlet {
  id                 String             @id @default(uuid()) @db.Uuid
  outletId           String             @unique @map("outlet_id")
  brand              OutletBrand
  district           String
  depot              Depot
  dockType           DockType           @map("dock_type")
  parkingConstraint  ParkingConstraint  @map("parking_constraint")
  mallWindow         String?            @map("mall_window")
  windowOpenTime     DateTime?          @map("window_open_time") @db.Time(0)
  windowCloseTime    DateTime?          @map("window_close_time") @db.Time(0)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders             Order[]

  @@map("outlets")
}

/// Vehicle master data. driver_user_id is an application assignment, not a vehicles.csv column.
model Vehicle {
  id                String                        @id @default(uuid()) @db.Uuid
  vehicleId         String                        @unique @map("vehicle_id")
  type              VehicleType
  temp              VehicleTemperatureCapability
  weightCapKg       Decimal                       @map("weight_cap_kg")
  volumeCapM3       Decimal                       @map("volume_cap_m3")
  fuelType          String                        @map("fuel_type")
  kmPerL            Decimal                       @map("km_per_l")
  weeklyFuelQuotaL  Decimal                       @map("weekly_fuel_quota_l")
  depot             Depot
  driverUserId      String?                       @map("driver_user_id") @db.Uuid
  driver            User?                         @relation(fields: [driverUserId], references: [id], onDelete: Restrict)
  trips             Trip[]
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([driverUserId])
  @@map("vehicles")
}

enum OrderStatus {
  DRAFT               @map("Draft")
  SUBMITTED           @map("Submitted")
  CONFIRMED           @map("Confirmed")
  DEFERRED            @map("Deferred")
  PLANNED_ALLOCATED   @map("Planned / Allocated")
  LOADING             @map("Loading")
  EXCEPTION_REPORTED  @map("Exception Reported")
  LOADED              @map("Loaded")
  DISPATCHED          @map("Dispatched")
  DELIVERED           @map("Delivered")
  RECEIPT_CONFIRMED   @map("Receipt Confirmed")

  @@map("order_status")
}

enum OrderTemperatureRequirement {
  chilled
  ambient

  @@map("order_temperature_requirement")
}

/// One logical order. Brand, district, and depot stay on Outlet. No trip or receipt fields.
model Order {
  id               String                      @id @default(uuid()) @db.Uuid
  deliveryId       String                      @unique @map("delivery_id")
  orderDate        DateTime                    @map("order_date") @db.Date
  outletId         String                      @map("outlet_id") @db.Uuid
  outlet           Outlet                      @relation(fields: [outletId], references: [id], onDelete: Restrict)
  createdByUserId  String                      @map("created_by_user_id") @db.Uuid
  createdBy        User                        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  status           OrderStatus
  tempRequirement  OrderTemperatureRequirement @map("temp_requirement")
  orderUnits       Int                         @map("order_units")
  orderWeightKg    Decimal                     @map("order_weight_kg")
  orderVolumeM3    Decimal                     @map("order_volume_m3")
  submittedAt      DateTime?                   @map("submitted_at") @db.Timestamptz(3)
  tripStops        TripStop[]
  deferrals        Deferral[]
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([outletId])
  @@index([createdByUserId])
  @@map("orders")
}

enum TripAllocationStatus {
  PLANNED
  CONFIRMED

  @@map("trip_allocation_status")
}

/// Application route. id is the internal UUID. route_id is the official route identifier, not the stop sequence.
model Trip {
  id              String               @id @default(uuid()) @db.Uuid
  routeId         String?              @unique @map("route_id")
  operationalDate DateTime             @map("operational_date") @db.Date
  vehicleId       String               @map("vehicle_id") @db.Uuid
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  depot           Depot
  tripNumber      Int                  @map("trip_number")
  status          TripAllocationStatus
  stops           TripStop[]
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([vehicleId, operationalDate, tripNumber])
  @@index([vehicleId])
  @@map("trips")
}

/// One ordered delivery stop. seq_in_route is 0-based and is not route_id.
model TripStop {
  id              String    @id @default(uuid()) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Restrict)
  orderId         String    @map("order_id") @db.Uuid
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sequence        Int       @map("seq_in_route")
  plannedArrival  DateTime? @map("planned_arrival") @db.Time(0)
  loadingRecords  LoadingRecord[]
  deliveryRecords DeliveryRecord[]
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tripId, sequence])
  @@index([tripId])
  @@index([orderId])
  @@map("trip_stops")
}

/// Loader verification for one allocated stop. Order is reached through TripStop.
model LoadingRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  tripStopId          String    @map("trip_stop_id") @db.Uuid
  tripStop            TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Restrict)
  loaderUserId        String    @map("loader_user_id") @db.Uuid
  loader              User      @relation("LoadingLoader", fields: [loaderUserId], references: [id], onDelete: Restrict)
  expectedUnits       Int       @map("expected_units")
  loadedUnits         Int       @map("loaded_units")
  shortfallUnits      Int?      @map("shortfall_units")
  verifiedAt          DateTime  @map("verified_at") @db.Timestamptz(3)
  shortfallReportedAt DateTime? @map("shortfall_reported_at") @db.Timestamptz(3)
  details             String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tripStopId])
  @@index([loaderUserId])
  @@map("loading_records")
}

/// Driver delivery execution for one allocated stop. Outcome is free text because no outcome list is approved.
model DeliveryRecord {
  id             String            @id @default(uuid()) @db.Uuid
  tripStopId     String            @map("trip_stop_id") @db.Uuid
  tripStop       TripStop          @relation(fields: [tripStopId], references: [id], onDelete: Restrict)
  driverUserId   String            @map("driver_user_id") @db.Uuid
  driver         User              @relation("DeliveryDriver", fields: [driverUserId], references: [id], onDelete: Restrict)
  deliveredAt    DateTime          @map("delivered_at") @db.Timestamptz(3)
  outcome        String
  deliveredUnits Int?              @map("delivered_units")
  notes          String?
  proofs         ProofOfDelivery[]
  receipt        Receipt?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tripStopId])
  @@index([driverUserId])
  @@map("delivery_records")
}

/// Evidence for a delivery. The reference is not a storage-provider URL.
model ProofOfDelivery {
  id                 String         @id @default(uuid()) @db.Uuid
  deliveryRecordId   String         @map("delivery_record_id") @db.Uuid
  deliveryRecord     DeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Restrict)
  evidenceReference  String         @map("evidence_reference")
  capturedAt         DateTime       @map("captured_at") @db.Timestamptz(3)
  capturedByUserId   String?        @map("captured_by_user_id") @db.Uuid
  capturedBy         User?          @relation("ProofCapturer", fields: [capturedByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([deliveryRecordId])
  @@index([capturedByUserId])
  @@map("proofs_of_delivery")
}

/// Application planning reason codes. These names are not Challenge Booklet terminology.
enum DeferralReason {
  NO_CAPACITY
  NO_REEFER
  VAN_ACCESS
  WINDOW_CONFLICT
  DEPOT_MISMATCH
  TIME_BUDGET

  @@map("deferral_reason")
}

/// A planning non-allocation. The order remains the order. History is not unique per order.
model Deferral {
  id         String         @id @default(uuid()) @db.Uuid
  orderId    String         @map("order_id") @db.Uuid
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reason     DeferralReason
  reportedAt DateTime       @map("reported_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orderId])
  @@map("deferrals")
}

/// Operational issue. No context foreign keys: an exception-context strategy is not approved.
model Exception {
  id               String   @id @default(uuid()) @db.Uuid
  category         String
  details          String?
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(3)
  reportedByUserId String?  @map("reported_by_user_id") @db.Uuid
  reportedBy       User?    @relation("ExceptionReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([reportedByUserId])
  @@map("exceptions")
}

/// Store Manager confirmation of one delivery. One current receipt per delivery record.
model Receipt {
  id                 String         @id @default(uuid()) @db.Uuid
  deliveryRecordId   String         @unique @map("delivery_record_id") @db.Uuid
  deliveryRecord     DeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Restrict)
  storeManagerUserId String         @map("store_manager_user_id") @db.Uuid
  storeManager       User           @relation("ReceiptStoreManager", fields: [storeManagerUserId], references: [id], onDelete: Restrict)
  confirmedAt        DateTime       @map("confirmed_at") @db.Timestamptz(3)
  result             String
  issueDetails       String?        @map("issue_details")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([storeManagerUserId])
  @@map("receipts")
}

/// Approved offline event types. Local states such as Pending Sync are not server values.
enum SyncEventType {
  DELIVERY_OUTCOME  @map("delivery outcome")
  PROOF_OF_DELIVERY @map("proof of delivery")

  @@map("sync_event_type")
}

/// Domain record named by a sync or audit reference. This is not a foreign key.
enum EventTargetType {
  Order
  Trip
  TripStop
  LoadingRecord
  DeliveryRecord
  ProofOfDelivery
  Deferral
  Exception
  Receipt

  @@map("event_target_type")
}

/// Server reconciliation record. The payload is not stored because its contents are not approved.
model SyncEvent {
  id                String          @id @default(uuid()) @db.Uuid
  clientEventId     String          @unique @map("client_event_id")
  eventType         SyncEventType   @map("event_type")
  targetType        EventTargetType @map("target_type")
  targetId          String          @map("target_id") @db.Uuid
  clientCreatedAt   DateTime        @map("client_created_at") @db.Timestamptz(3)
  receivedAt        DateTime        @map("received_at") @db.Timestamptz(3)
  errorCode         String?         @map("error_code")
  errorMessage      String?         @map("error_message")
  lastAttemptAt     DateTime?       @map("last_attempt_at") @db.Timestamptz(3)
  attemptCount      Int?            @map("attempt_count")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@map("sync_events")
}

/// Historical security or domain action. No updated timestamp: later tasks own immutability.
model AuditEvent {
  id           String           @id @default(uuid()) @db.Uuid
  action       String
  occurredAt   DateTime         @map("occurred_at") @db.Timestamptz(3)
  actorUserId  String?          @map("actor_user_id") @db.Uuid
  actor        User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  targetType   EventTargetType? @map("target_type")
  targetId     String?          @map("target_id") @db.Uuid
  details      String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@map("audit_events")
}

/// Competition calendar source rows. Not an application-domain entity. The source date is the identity.
model CalendarSource {
  date          DateTime @id @map("date") @db.Date
  dow           Int
  dowName       String   @map("dow_name")
  isWeekend     Int      @map("is_weekend")
  isoYear       Int      @map("iso_year")
  isoWeek       Int      @map("iso_week")
  isPayday      Int      @map("is_payday")
  festival      String
  festivalRamp  String   @map("festival_ramp")
  isHoliday     Int      @map("is_holiday")
  monsoon       Int
  isOperating   Int      @map("is_operating")

  @@map("calendar_source")
}
