# Names and placeholders only. Do not put real passwords, API keys, or tokens in this file.
# Copy values into an untracked .env for local development. Do not commit .env.
# Development, test, and production are separate. Do not reuse a development file for test or production.

# Application
# Required everywhere: development, test, or production.
# Production also requires API_HOST, API_PORT, DATABASE_URL, LOGIN_RATE_LIMIT_MAX,
# LOGIN_RATE_LIMIT_WINDOW_SECONDS, PLANNING_HOST, and PLANNING_PORT.
# See docs/production-configuration.md. Do not set PLANNING_SERVICE_URL; no integration URL is approved.
NODE_ENV=development

# API
# Local development defaults are 127.0.0.1 and 4000 when these are omitted.
# Production must set both. The API uses DATABASE_URL for the selected local database.
API_HOST=127.0.0.1
API_PORT=4000

# Database
# Local PostgreSQL only. Replace every PASSWORD outside source control.
# wayloom_bootstrap is the setup superuser. wayloom_app is the application role.
# wayloom_development and wayloom_test are separate databases.
POSTGRES_PASSWORD=PASSWORD
WAYLOOM_APP_PASSWORD=PASSWORD
# DATABASE_URL=postgresql://wayloom_app:PASSWORD@127.0.0.1:5432/wayloom_development
# TEST_DATABASE_URL=postgresql://wayloom_app:PASSWORD@127.0.0.1:5432/wayloom_test
# Seed and competition imports refuse non-local DATABASE_URL. When DATABASE_URL points at a remote
# host, start Docker Postgres (see database/postgres/README.md) and run:
# npm run gate:setup-local --workspace @wayloom/api
# Remote development uses the session-mode pooler on port 5432.
# Put the real URL only in the untracked .env. Do not commit it here.
# DIRECT_URL=

# Authentication
# Sessions use a random identifier stored only as a hash. CSRF uses that identifier.
# Neither mechanism reads a server signing secret.

# Login failure limit. Units are failed attempts and seconds.
# Development and test use 20 failed attempts and 900 seconds when both are omitted.
# Production must set both. No production threshold is approved in this file.
# LOGIN_RATE_LIMIT_MAX=
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=

# Planning Service
# The deterministic engine runs in the API. No separate planning integration URL is approved.
# PLANNING_SERVICE_URL=
# Bind address for this Python process. This is not an integration URL.
# Local development defaults are 127.0.0.1 and 8000 when these are omitted.
# Production must set both.
PLANNING_HOST=127.0.0.1
PLANNING_PORT=8000

# AI / Provider Configuration
# Decision support stays off unless AI_ENABLED=true and AI_PROVIDER=deterministic.
# Do not put a provider key in this file. A key belongs only in an untracked environment.

# Web
# The frontend reads this repository environment file.
# Do not put server secrets in a browser-visible variable.
# Docker Compose publishes the frontend on 127.0.0.1:3000 and the API on 127.0.0.1:4000.
# Those are different browser origins. No production domain is configured.
# WEB_ORIGIN is the browser origin allowed to call the API. The API does not copy the request Origin.
# Development and test use http://127.0.0.1:3000 when WEB_ORIGIN is omitted.
# Production sends no CORS headers until WEB_ORIGIN is the real https origin.
# WEB_HTTPS=true sends HSTS only when NODE_ENV is production. Leave it unset for local HTTP.
# API_ORIGIN is the browser API origin in the frontend Content-Security-Policy connect-src.
# Development and test use http://127.0.0.1:4000 when API_ORIGIN is omitted.
# Production allows frontend connections only to the page origin until API_ORIGIN is the real https API origin.
# WEB_ORIGIN=
# WEB_HTTPS=
# API_ORIGIN=

# Docker Compose
# `docker compose up -d` starts postgres, api, planning, and web.
# Host development keeps the 127.0.0.1 addresses in this file.
# Inside Compose, the API receives DATABASE_URL with hostname postgres, and the API and planning processes bind 0.0.0.0.
# Those container values are not browser configuration. No planning integration URL is approved.

# Observability
LOG_LEVEL=info
